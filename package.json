{
  "name": "gameharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:native": "sh native/minecraft/gradlew -p native/minecraft build",
    "build:pilot": "sh native/minecraft/gradlew -p survival-pilot build",
    "play:pilot": "xvfb-run -a -s '-screen 0 1280x720x24 -nolisten tcp' bun survival-pilot/run.ts",
    "watch:pilot": "bun survival-pilot/watch.ts",
    "build:ui": "vite build",
    "build": "bun run build:native && bun run build:ui",
    "start": "bun scripts/start.ts",
    "check": "bun scripts/check.ts",
    "check:types": "bun scripts/check.ts types",
    "check:unit": "bun scripts/check.ts unit",
    "check:integration": "bun scripts/check.ts integration",
    "test": "bun test",
    "test:unit": "bun scripts/check.ts unit",
    "test:integration": "bun scripts/check.ts integration",
    "evaluate": "bun scripts/evaluate.ts",
    "evaluate:native": "bun scripts/evaluate.ts native-game",
    "evaluate:agent": "bun scripts/evaluate.ts agent-acceptance"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jura": "5.3.0",
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-utils": "18.12.3",
    "acorn": "8.15.0",
    "electron": "45.0.0",
    "eslint-scope": "9.1.2",
    "prettier": "3.9.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
