{
  "name": "gameharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:native": "sh native/minecraft/gradlew -p native/minecraft build",
    "build:ui": "vite build",
    "build": "bun run build:native && bun run build:ui",
    "start": "bun scripts/start.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jura": "5.3.0",
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-utils": "18.12.3",
    "acorn": "8.15.0",
    "electron": "45.0.0",
    "prettier": "3.9.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
