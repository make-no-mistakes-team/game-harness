{
  "name": "gameharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun scripts/start.ts",
    "desktop": "bun scripts/desktop.ts",
    "build:mod": "sh mod/gradlew -p mod build",
    "build:agent": "sh mod/gradlew -p mod build",
    "test:mod": "sh mod/gradlew -p mod test",
    "build:ui": "vite build",
    "build": "bun run build:agent && bun run build:ui",
    "play:agent": "xvfb-run -a -s '-screen 0 1280x720x24 -nolisten tcp' bun src/agent/run.ts",
    "watch:agent": "bun src/agent/watch.ts",
    "review:agent": "bun src/agent/reviews.ts",
    "stop:agent": "bun src/agent/operator-stop.ts",
    "release-orphan": "bun src/agent/release-orphan.ts",
    "diagnose:pool": "xvfb-run -a -s '-screen 0 1280x720x24 -nolisten tcp' bun src/agent/run.ts --diagnostic-pool",
    "diagnose:combat": "bun src/diagnostics/combat.ts",
    "diagnose:descent": "bun src/diagnostics/descent.ts",
    "check": "bun scripts/check.ts",
    "check:types": "bun scripts/check.ts types",
    "check:unit": "bun scripts/check.ts unit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jura": "5.3.0",
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-utils": "18.12.3",
    "electron": "45.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
