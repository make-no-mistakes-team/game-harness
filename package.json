{
  "name": "gameharness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build:bridge": "bun build src/bridge/index.ts --target=node --packages=external --outfile=dist/bridge/index.mjs",
    "build": "bun run build:bridge && vite build",
    "start": "bun scripts/start.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jura": "5.3.0",
    "@oh-my-pi/pi-agent-core": "18.12.3",
    "@oh-my-pi/pi-ai": "18.12.3",
    "@oh-my-pi/pi-catalog": "18.12.3",
    "@oh-my-pi/pi-utils": "18.12.3",
    "mineflayer": "4.39.0",
    "prismarine-viewer": "1.33.0",
    "socket.io": "4.8.4",
    "vec3": "0.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
